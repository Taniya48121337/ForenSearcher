<script>
$(document).ready(function() {
  'use strict';
  
  // Spamtrap setup
  $("#spamtrap").val("SpamProof");
  
  // UTM parameters
  var queryString1 = window.location.search;
  var urlParams1 = new URLSearchParams(queryString1);
  var campaign1 = urlParams1.get('utm_campaign');
  var source1 = urlParams1.get('utm_source');
  var medium1 = urlParams1.get('utm_medium');
  var term1 = urlParams1.get('utm_term');
  $('#newsletter-form #utm_source-newsletter-form').val(source1);
  $('#newsletter-form #utm_campaign-newsletter-form').val(campaign1);
  $('#newsletter-form #utm_medium-newsletter-form').val(medium1);
  $('#newsletter-form #utm_term-newsletter-form').val(term1);

  // Multi-step form functionality
  var formData = {};

  // Remove error styling on input
  $('#newsletter-form input.required').on('input change', function() {
    $(this).removeClass('error-border');
    $(this).siblings('.error-message').removeClass('show');
    if ($(this).attr('type') === 'checkbox') {
      $(this).next('.error-message').removeClass('show');
    }
  });

  function scrollToElement(element) {
    if (element && element.length) {
      var scrollTop = element.offset().top - 100;
      window.scrollTo({
        top: scrollTop,
        behavior: 'smooth'
      });
    }
  }

  function validateForm() {
    var isValid = true;
    var firstErrorElement = null;
    
    $('.error-border').removeClass('error-border');
    $('.error-message').removeClass('show');
    
    // Validate email
    var emailVal = $('#newsletter-email').val().trim();
    var emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailVal || !emailRegex.test(emailVal)) {
      $('#newsletter-email').addClass('error-border');
      $('#email-error').addClass('show');
      isValid = false;
      if (!firstErrorElement) firstErrorElement = $('#newsletter-email');
    }
    
    // Validate phone
    if (!$('#newsletter-phone').val().trim()) {
      $('#newsletter-phone').addClass('error-border');
      $('#phone-error').addClass('show');
      isValid = false;
      if (!firstErrorElement) firstErrorElement = $('#newsletter-phone');
    }
    
    // Validate agreement checkbox
    if (!$('#agree-modal').is(':checked')) {
      $('#agree-error').addClass('show');
      isValid = false;
      if (!firstErrorElement) firstErrorElement = $('#agree-modal');
    }
    
    if (!isValid && firstErrorElement) {
      scrollToElement(firstErrorElement);
    }
    
    return isValid;
  }

  function collectFormData() {
    formData = {
      email: $('#newsletter-email').val().trim(),
      phone: $('#newsletter-phone').val().trim(),
      agree: $('#agree-modal').is(':checked')
    };
  }

  function showConfirmation() {
    collectFormData();
    
    // Populate confirmation panel
    $('#confirm-email').text(formData.email);
    $('#confirm-phone').text(formData.phone);
    $('#confirm-agree').html('<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="color: #28a745;"><polyline points="20 6 9 17 4 12"></polyline></svg> Agreed to privacy policy and terms');
    
    // Hide form, show confirmation
    $('#newsletter-form-step1').addClass('form-hidden');
    $('#newsletter-form-confirmation').addClass('show').show();
    
    scrollToElement($('#newsletter-form-confirmation'));
  }

  // Edit button - go back to form
  $('#newsletter-form-edit').on('click', function() {
    $('#newsletter-form-confirmation').removeClass('show').hide();
    $('#newsletter-form-step1').removeClass('form-hidden');
    scrollToElement($('#newsletter-form'));
  });

  // Validate button
  $('#newsletter-form-validate').on('click', function() {
    if (validateForm()) {
      showConfirmation();
    }
  });
});
</script>

