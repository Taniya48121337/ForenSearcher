<script>
(async function () {
  const FEATURED_FEED_URL = "https://bonginoreport.com/article-priority-featured-feed.json";
  const REGULAR_FEED_URL = "https://bonginoreport.com/article-feed.json";
  const MOUNT_ID = "articlesRowMount";
  const mount = document.getElementById(MOUNT_ID);
  if (!mount) return;

  function esc(s) {
    return String(s || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function formatDate(d) {
    if (!d) return "";
    const dt = new Date(d);
    if (!isNaN(dt.getTime())) {
      return dt.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
    }
    return d;
  }

  async function fetchAndParseFeed(url) {
    const res = await fetch(url);
    if (!res.ok) {
      throw new Error(`HTTP ${res.status}: ${res.statusText}`);
    }
    let text = await res.text();
    // Fix JSON - add commas between objects that are missing them
    text = text.replace(/\}(\s*)\{/g, '},$1{');
    const data = JSON.parse(text);
    let items = data.items || [];
    
    // Map and format items
    return items.map(item => ({
      title: item.title || "",
      link: item.url || item.link || "",
      date: formatDate(item.date),
      author: item.article_author || "",
      image: item.image || ""
    })).filter(x => x.title && x.link);
  }

  try {
    // Fetch both feeds in parallel
    const [featuredItems, regularItems] = await Promise.all([
      fetchAndParseFeed(FEATURED_FEED_URL),
      fetchAndParseFeed(REGULAR_FEED_URL)
    ]);

    // Get featured article from priority feed
    const featured = featuredItems[0];
    
    // Get 5 articles from regular feed
    const list = regularItems.slice(0, 5);

    if (!featured) {
      mount.innerHTML = `<div class="row"><div class="col-12 text-center">No featured article found.</div></div>`;
      return;
    }

    const featuredHTML = `
      <div class="col-md-6 mb-md-0 mb-5">
        ${featured.image ? `
          <a href="${esc(featured.link)}" target="_blank" rel="noopener">
            <img src="${esc(featured.image)}" alt="${esc(featured.title)}" class="img-fluid mb-3 rounded" onerror="this.style.display='none'">
          </a>
        ` : ""}
        <a href="${esc(featured.link)}" target="_blank" rel="noopener" class="text-white text-decoration-none">
          <h4 class="fw-bold mt-3">${esc(featured.title)}</h4>
        </a>
        <div class="mt-4">
          ${featured.author ? `<span class="horizontal-item_author text-danger">${esc(featured.author)}</span>` : ""}
          ${featured.date ? `<span class="horizontal-item_date">${featured.author ? ' - ' : ''}${esc(featured.date)}</span>` : ""}
        </div>
      </div>
    `;

    const listHTML = list.map(item => `
      <div class="row mb-3">
        <div class="col-12">
          <a href="${esc(item.link)}" target="_blank" rel="noopener" class="text-decoration-none text-white">
            <h5 class="fw-bold">${esc(item.title)}</h5>
          </a>
        </div>
        <div class="col-12"><div class="article-divider"></div></div>
      </div>
    `).join("");

    mount.innerHTML = `
      <div class="row">
        ${featuredHTML}
        <div class="col-md-6 px-md-4">
          ${listHTML}
        </div>
      </div>
    `;

  } catch (err) {
    console.error("Feed error:", err);
    mount.innerHTML = `
      <div class="row">
        <div class="col-12 text-center">
          <p class="text-danger">Unable to load feed</p>
          <small class="text-muted">${esc(err.message)}</small>
        </div>
      </div>
    `;
  }
})();
</script>



