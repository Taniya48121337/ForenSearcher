th:dA,isa_value:v,title:l,slug:v},fn__image:{content_type:q,content:{thumbnail:u,description:Q,id:x,title:R,brightcoveAccount:H}},fn__legacy_type:S,components:[{is:"VideoInline",props:{type:q,title:R,caption:Q,videoId:x,imageUrl:u,originalImageUrl:u,url:"http:\u002F\u002Fvideo.foxnews.com\u002Fv\u002F6025576909001",videoDomain:"foxnews",isFeatured:c}},{is:h,props:{text:"Democrat \u003Ca href=\"https:\u002F\u002Fwww.foxnews.com\u002Fcategory\u002Fpolitics\u002Fhouse-of-representatives\"\u003ERep\u003C\u002Fa\u003E. Frederica Wilson said people who are “making fun” of members of Congress online&nbsp;should be “prosecuted.”"}},{is:h,props:{text:"The Florida \u003Ca href=\"https:\u002F\u002Fwww.foxnews.com\u002Fcategory\u002Fpolitics\u002Fhouse-of-representatives\u002Fdemocrats\"\u003Econgresswoman \u003C\u002Fa\u003Emade the comments on Tuesday outside of the Homestead Temporary Shelter for Unaccompanied Children in her home state."}},{is:h,props:{text:"\"Those people who are online making fun of members of Congress are a disgrace, and there is no need for anyone to think that is unacceptable [sic],” Wilson said."}},{is:h,props:{text:"“We're gonna shut them down and work with whoever it is to shut them down, and they should be prosecuted,” she added. “You cannot intimidate members of Congress, frighten members of Congress. It is against the law, and it's a shame in this United States of America.”"}},{is:"TwitterTweet",props:{id:"1146143587811258370",hideThread:b,hideMedia:b,darkTheme:void 0}},{is:h,props:{text:"\u003Cstrong\u003E\u003Ca href=\"https:\u002F\u002Fwww.foxnews.com\u002Fpolitics\u002Fwhat-to-know-about-frederica-wilson-florida-democrat-who-criticized-trump\"\u003EWHAT TO KNOW ABOUT FREDERICA WILSON, FLORIDA DEMOCRAT WHO CRITICIZED TRUMP\u003C\u002Fa\u003E\u003C\u002Fstrong\u003E"}},{is:h,props:{text:"Wilson’s comments came amid a controversy over a Facebook group that includes Border Patrol agents and where they allegedly mocked and posted graphic content about members of Congress, including New York Rep. Alexandria Ocasio-Cortez."}},{is:h,props:{text:"The website ProPublica posted a story Monday headlined “Inside the Secret Border Patrol Facebook Group Where Agents Joke About Migrant Deaths and Post Sexist Memes.”"}},{is:h,props:{text:"In addition to showing indifference toward the deaths of migrants, members made vulgar jokes about Ocasio-Cortez and other members of the Congressional Hispanic Caucus ahead of their visit a Border Patrol facility in Texas on Monday, the story alleged."}},{is:h,props:{text:"\u003Cstrong\u003E\u003Ca href=\"https:\u002F\u002Fwww.foxnews.com\u002Fpolitics\u002Focasio-cortez-accuses-border-officers-of-violent-culture-after-report-on-graphic-facebook-posts\"\u003EOCASIO-CORTEZ ACCUSES BORDER OFFICERS OF ‘VIOLENT CULTURE’ AFTER REPORT ON GRAPHIC FACEBOOK POSTS\u003C\u002Fa\u003E\u003C\u002Fstrong\u003E"}},{is:h,props:{text:"Wilson also blamed President Trump for people losing respect for Congress and the White House, saying he has “taken this country to its knees.”"}},{is:h,props:{text:"She once accused Trump of being “hateful towards black people” and declined to participate in the State of the Union address in 2018."}},{is:h,props:{text:"\u003Cstrong\u003E\u003Ca href=\"https:\u002F\u002Fwww.foxnews.com\u002Fapps-products?pid=AppArticleLink\"\u003ECLICK HERE TO GET THE FOX NEWS APP\u003C\u002Fa\u003E\u003C\u002Fstrong\u003E"}},{is:h,props:{text:"The congresswoman also rose to prominence in 2017 after she leaked the conversation Trump had with the Gold Star widow whose husband died in Niger and criticized the president for being “so insensitive” after he said that the slain soldier “knew what he signed up for…but when it happens, it hurts anyway.”"}}],fn__section_title:f,dateline:a,fn__footer:a,title:f,fn__type:fE,short_title:f,publication_date:fF,wp__tags:[{path:fG,isa_value:dB,title:fH,slug:dB},{path:fI,isa_value:fJ,title:"HOUSE OF REPRESENTATIVES",slug:"house-of-representatives-politics