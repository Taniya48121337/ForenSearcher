antOnlyWhite" href="/policies/privacy"><span class="text-module_textSizeM text-module_textSizeFixedXS text-module_textWeightMEDIUM text-module_textLineHeightBODY text-module_textFontStyleNORMAL">Privacy policy</span></a></li></ul></div></div></div></footer></div><script id="__NEXT_DATA__" type="application/json">{"props":{"pageProps":{"story":{"alternates":[],"content":{"_uid":"55608fdc-9737-4c06-9bf5-8fff08feadf6","component":"ArticleTemplate","SEO":[{"_uid":"631f0ac2-3221-4c40-b467-b3747f0489c8","HowTo":[],"title":"Surprising breathalyser triggers (even when you haven't been drinking)","robots":[],"component":"SEO","openGraph":[],"description":"See the food, drink and everyday products that could trigger a breathalyser, even when you're sober","twitterCard":[],"canonicalUrl":""}],"body":{"type":"doc","content":[{"type":"heading","attrs":{"level":2,"textAlign":null},"content":[{"text":"Everyday foods and products that can briefly affect a reading ","type":"text"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Some items are more likely to cause this than others, particularly anything linked to fermentation, high sugar content or alcohol-based ingredients. ","type":"text"}]},{"type":"heading","attrs":{"level":3,"textAlign":null},"content":[{"text":"Hot cross buns ","type":"text"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Made with yeast, sugar and dried fruit, hot cross buns can produce tiny amounts of ethanol as they break down. ","type":"text"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"One driver","type":"text","marks":[{"type":"link","attrs":{"href":"https://www.facebook.com/PHHGWA/videos/just-a-little-word-of-caution-before-you-all-get-stuck-into-your-hot-cross-buns-/392032991371862/","uuid":null,"anchor":null,"target":"_self","linktype":"url"}}]},{"text":" recorded a brief positive reading immediately after eating one, despite not consuming any alcohol.  ","type":"text"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"These readings typically return to zero within minutes as any residue clears from the mouth. ","type":"text"}]},{"type":"heading","attrs":{"level":3,"textAlign":null},"content":[{"text":"Jackfruit ","type":"text"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Popular in many plant-based diets as a meat alternative, jackfruit contains high levels of natural sugar, particularly when overripe. As the fruit ripens further, those sugars can begin to ferment and produce small amounts of alcohol. ","type":"text"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"In one ","type":"text"},{"text":"reported case in India","type":"text","marks":[{"type":"link","attrs":{"href":"https://www.hindustantimes.com/india-news/kerala-drivers-fail-breath-test-despite-not-drinking-courtesy-jackfruit-101753275082717.html","uuid":null,"anchor":null,"target":"_self","linktype":"url"}}]},{"text":", bus drivers triggered positive breathalyser readings before starting work after eating overripe jackfruit.  ","type":"text"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"The results were temporary and not linked to intoxication, but they highlight how naturally fermenting foods can impact readings. ","type":"text"}]},{"type":"heading","attrs":{"level":3,"textAlign":null},"content":[{"text":"Toothpaste and mouthwash ","type":"text"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Some types of mouthwash, and some toothpaste formulations, contain alcohol or alcohol-based compounds. ","type":"text"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Studies have shown that alcohol-based mouthwash can temporarily elevate breathalyser readings if used shortly beforehand, as residual ethanol remains in the mouth before dissipating quickly. ","type":"text"}]},{"type":"heading","attrs":{"level":3,"textAlign":null},"content":[{"text":"Cough syrups and liquid medicines ","type":"text"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Some liquid medicines, particularly cough syrups and cold and flu remedies, contain small amounts of alcohol. ","type":"text"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"In some cases, these formulations can contain measurable levels of ethanol, which can leave temporary residue in the mouth if taken shortly before a test. ","type":"text"}]},{"type":"heading","attrs":{"level":3,"textAlign":null},"content":[{"text":"Hand sanitiser ","type":"text"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"It’s not just eating or brushing your teeth that can lead to an unexpected breathalyser reading.  ","type":"text"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Using hand sanitiser just before taking the test might also show up, according to research published in the American Journal of Infection Control.  ","type":"text"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"In controlled tests, readings briefly increased after ethanol-based hand sanitiser was used shortly before testing, before returning to normal within minutes. ","type":"text"}]},{"type":"heading","attrs":{"level":2,"textAlign":null},"content":[{"text":"How breathalysers actually work ","type":"text"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Breathalysers are designed to measure blood alcohol level (BAC), which authorities use to gauge a driver’s level of intoxication. ","type":"text"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"When we drink alcohol, it enters the bloodstream, and some of that alcohol evaporates into our lungs as the blood moves through them. ","type":"text"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"A breathalyser measures the concentration of ethanol (the type of alcohol in alcoholic drinks) in your breath using a chemical reaction, then does a calculation to determine your BAC.  ","type":"text"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"“The key difference is where the alcohol is coming from,” says Ben. “Breathalysers are designed to measure alcohol in the bloodstream, but in some situations, they can briefly detect alcohol in the mouth instead. That’s why proper testing procedures include a waiting period.” ","type":"text"}]},{"type":"heading","attrs":{"level":2,"textAlign":null},"content":[{"text":"What drivers should know ","type":"text"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"The chances of everyday items causing a meaningful breathalyser reading are very low, especially under proper testing conditions. ","type":"text"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Officers typically wait around 15 minutes before carrying out a formal test to allow time for any food, drink or residue in the mouth to clear. ","type":"text"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Still, it’s a useful reminder of how sensitive breathalysers can be immediately after eating, drinking or using certain products. ","type":"text"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"image","attrs":{"id":12320978,"alt":"A banner reading: 'quality cars for under £200 a month, see what's in stock'","src":"https://a.storyblok.com/f/143588/2100x600/92b1202390/onsite_sales_banner_finance_v03.png","title":"","source":"","copyright":"","meta_data":{}},"marks":[{"type":"link","attrs":{"href":"https://www.cinch.co.uk/used-cars?toPrice=200\u0026useMonthly=true\u0026selectedModel=\u0026transmissionType=\u0026variant=\u0026ICID=ban%7C%7Cbanner%7Csales-banner%7Cfinance%7C%7C","uuid":null,"anchor":null,"target":"_self","linktype":"url"}}]}]},{"type":"heading","attrs":{"level":2,"textAlign":null},"content":[{"text":"Read more insider driver news:","type":"text"}]},{"type":"bullet_list","content":[{"type":"list_item","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"One fine every 30 seconds for bus lane misuse","type":"text","marks":[{"type":"link","attrs":{"href":"https://www.cinch.co.uk/news/bus-lane-fines-crackdown","uuid":null,"anchor":null,"target":"_self","linktype":"url"}},{"type":"bold"}]}]}]},{"type":"list_item","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"342,000 cars stolen in four years","type":"text","marks":[{"type":"link","attrs":{"href":"https://www.cinch.co.uk/news/car-theft-statistics","uuid":null,"anchor":null,"target":"_self","linktype":"url"}},{"type":"bold"}]}]}]}]}]},"image":{"id":124720425102381,"alt":"A woman being breathalysed inside a car","name":"","focus":"","title":"","source":"","filename":"https://a.storyblok.com/f/143588/1254x836/80ab235113/breathalyser-191225.jpg","copyright":"","fieldtype":"asset","meta_data":{"alt":"A woman being breathalysed inside a car","title":"","source":"","copyright":""},"is_external_url":false},"quote":"","title":"Surprising breathalyser triggers (even when you haven't been drinking)","video":[],"subTitle":"Get the details on which ethanol-containing items might trigger a breathalyser test","authorByline":[{"_uid":"be10005f-e25d-419e-943e-c6f992079245","name":"Craig Hale","image":{"id":16999114,"alt":"Craig Hale","name":"","focus":"","title":"","source":"","filename":"https://a.storyblok.com/f/143588/832x832/62c4465f55/ab_craighale_001.jpg","copyright":"","fieldtype":"asset","meta_data":{"alt":"Craig Hale","title":"","source":"","copyright":""},"is_external_url":false},"component":"AuthorByline"}],"leadParagraph":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Some foods, drinks and everyday products can leave trace amounts of ethanol in the mouth, which could briefly show up if a test is taken shortly after use. ","type":"text"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Our new research reveals how some foods, toothpastes or cough syrups can lead to false breathalyser readings. ","type":"text"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Whether you're driving an ","type":"text"},{"text":"Audi","type":"text","marks":[{"type":"link","attrs":{"href":"https://www.cinch.co.uk/used-cars/audi","uuid":null,"anchor":null,"target":"_self","linktype":"url"}}]},{"text":", ","type":"text"},{"text":"BMW","type":"text","marks":[{"type":"link","attrs":{"href":"https://www.cinch.co.uk/used-cars/bmw","uuid":null,"anchor":null,"target":"_self","linktype":"url"}}]},{"text":" or ","type":"text"},{"text":"other brand","type":"text","marks":[{"type":"link","attrs":{"href":"https://www.cinch.co.uk/used-cars","uuid":null,"anchor":null,"target":"_self","linktype":"url"}}]},{"text":", it's always important to be under the limit behind the wheel. ","type":"text"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Ben Welham, our motoring expert, says: “Most people are surprised to learn that something as innocent as a hot cross bun could briefly show up on a breath test.  ","type":"text"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"“It won't get you in trouble, but it's a good reminder of just how sensitive these devices can be.” ","type":"text"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"image","attrs":{"id":84811985029251,"alt":"Faff-free servicing and MOTs","src":"https://a.storyblok.com/f/143588/2100x600/bda2655e90/cinchservice-banner-28925.png","title":"","source":"","copyright":"","meta_data":{"alt":"Faff-free servicing and MOTs","title":"","source":"","copyright":""}},"marks":[{"type":"link","attrs":{"href":"https://www.cinch.co.uk/car-care/servicing?ICID=ban%7C%7Cbanner%7Cservicing-banner%7C%7C%7Cbook-yours-today","uuid":null,"anchor":null,"target":"_self","linktype":"url"}}]}]}]},"relatedJargon":[{"name":"Driver Vehicle Licencing Agency","created_at":"