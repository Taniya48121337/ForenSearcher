f_1790753095456412_5512","more_section_offset":-1,"mp_full_article":true,"mp_location":"Minneapolis, MN","mp_post_type":"manual","mp_source_type":"creator","mp_tags_manual":[{"id":"Dinning","name":"Dinning"},{"id":"Closure","name":"Closure"},{"id":"Resturuant","name":"Resturuant"}],"mtype":2,"nb_video":{},"nbid":"daytrippe_8cf99","offline_mode_disabled":false,"origin_view_type":"web","original_url":"https://mp.newsbreakapp.com/post/165499302?sig=56FC6BD33D4EB36AEF3CB379F13998A7","picked_location":{"address":"Minneapolis, MN, USA","coord":"44.977753,-93.26501","displayName":"Minneapolis, MN","id":"ChIJvbt3k5Azs1IRB-56L4TJn5M","name":"Minneapolis","type":"place_id"},"post_category":{},"post_id":165499302,"post_publish_time":0,"referer":"https://www.newsbreakapp.com","scope":0,"scope_web":0,"share_count":2,"show_as_bloom_ads":false,"source":"DayTripper","summary":"Marrow restaurant, a fine-dining spot known for its French technique and seasonal menus, has closed its doors after three years of operation in Minnesota. The closure reflects challenges facing upscale restaurants across the country right now.","tagline":"Writer","text_category":{"first_cat":{"Lifestyle":0.7542306098533801},"second_cat":{"Lifestyle_FoodDrink":0.7219261248948756},"third_cat":{"Lifestyle_FoodDrink_Restaurants":0.80213628600868}},"title":"Marrow Restaurant Shuts Down: What It Means for Minnesota Dining","unified_category":"Lifestyle","up":5,"url":"https://h5.newsbreakapp.com/mp/1CZzQwR6?cv=\u0026platform=2","url_before_mp_full_article":"https://mp.newsbreakapp.com/post/165499302?sig=56FC6BD33D4EB36AEF3CB379F13998A7","video_category":{},"video_metadata":{"default_cover_with_play_icon_cdn_url":"","default_first_frame_cdn_url":""},"viewType":"web","vote":0},{"ai_summary":"","amp":"https://mp.newsbreakapp.com/post/165062558?sig=08F25B6FBF287AF1972F4CEF80B7D5E2","audio_file":"","audio_length_sec":0,"canonical_url":"https://mp.newsbreakapp.com/post/165062558?sig=08F25B6FBF287AF1972F4CEF80B7D5E2","certifications_badges":[{"dark_color":"#FF5A5A","dark_icon":"https://i.prt.news/t_200_200_ff128e59e44fd908bc949f34bde102c1.png","description":"Users in NewsBreak’s Contributor Program who have verified their accounts by showing some writing experience on other platforms.","es_description":"Usuarios en el Programa de Colaboradores de NewsBreak que han verificado sus cuentas mostrando algo de experiencia en redacción en otras plataformas.","light_color":"#FF5A5A","light_icon":"https://i.prt.news/t_200_200_ff128e59e44fd908bc949f34bde102c1.png","name":"writer","text":"Writer","type":"certification"}],"city_name":"Duluth, Minnesota","comment_count":0,"comment_user_count":0,"content":"\u003cbody\u003e\u003cp class=\"NBAIEditor_Theme__paragraph\" dir=\"ltr\"\u003e\u003cspan\u003eSaturday morning, June 20, thousands of runners will line up in Two Harbors and begin one of Minnesota's most beloved traditions: Grandma's Marathon. The 50th annual race marks a milestone for what started as a tiny local event with just 160 runners in 1977.\u003c/span\u003e\u003c/p\u003e\u003cp class=\"NBAIEditor_Theme__paragraph\" dir=\"ltr\"\u003e\u003cspan\u003eFor those planning to be in Duluth this weekend, here's what you need to know about this iconic race and the marathon weekend festivities.\u003c/span\u003e\u003c/p\u003e\u003ch2 class=\"NBAIEditor_Theme__h2\" dir=\"ltr\"\u003e\u003cspan\u003eThe Course: A Runner's Dream\u003c/span\u003e\u003c/h2\u003e\u003cp class=\"NBAIEditor_Theme__paragraph\" dir=\"ltr\"\u003e\u003cspan\u003eGrandma's Marathon isn't just popular—it's legendary among distance runners. The 26.2-mile course is a point-to-point route that starts in Two Harbors and follows scenic Highway 61 along Lake Superior all the way to Duluth's Canal Park.\u003c/span\u003e\u003c/p\u003e\u003cp class=\"NBAIEditor_Theme__paragraph\" dir=\"ltr\"\u003e\u003cspan\u003eWhat makes Grandma's special? The course is fast. With a net downhill elevation loss of about 130 feet from start to finish, runners experience a gentle grade that helps them maintain momentum. Combine that with stunning lake views and well-organized aid stations every two miles, and you've got a recipe for personal records.\u003c/span\u003e\u003c/p\u003e\u003cp class=\"NBAIEditor_Theme__paragraph\" dir=\"ltr\"\u003e\u003cspan\u003eThe race finishes near the iconic Aerial Lift Bridge in Canal Park, making for a spectacular finale as runners cross the finish line with Lake Superior as their backdrop.\u003c/span\u003e\u003c/p\u003e\u003cfigure\u003e\u003cdiv data-editornodeinfo=\"%7B%22type%22%3A%22editor-image-node%22%2C%22imageUrl%22%3A%22https%3A%2F%2Fi.prt.news%2Ff73c83b222cdf62f9c349c7fbe5149d9.blob%22%2C%22imageCaption%22%3A%22%22%2C%22creditText%22%3A%22Grandma's%20Marathon%20-%20Duluth%2C%20Inc.%20%7C%20Facebook%22%2C%22creditUrl%22%3A%22https%3A%2F%2Fwww.facebook.com%2Fphoto.php%3Ffbid%3D1395397302627050%26set%3Dpb.100064703799229.-2207520000%26type%3D3%22%2C%22imagePlatform%22%3A%22SELF_UPLOAD%22%2C%22imageOriginalWidth%22%3A851%2C%22imageOriginalHeight%22%3A548%7D\"\u003e\u003cdiv class=\"editor-image-wrap\"\u003e\u003cdiv class=\"editor-image\"\u003e\u003cimg class=\"\" src=\"https://img.particlenews.com/image.php?type=thumbnail_580x000\u0026amp;url=3W6cxE_1CT3vFx900\" data-image-caption=\"\" data-credit-text=\"Grandma's Marathon - Duluth, Inc. | Facebook\" data-credit-url=\"https://www.facebook.com/photo.php?fbid=1395397302627050\u0026amp;set=pb.100064703799229.-2207520000\u0026amp;type=3\" data-image-platform=\"SELF_UPLOAD\" data-image-original-width=\"851\" data-image-original-height=\"548\" alt=\"https://img.particlenews.com/image.php?url=3W6cxE_1CT3vFx900\" width=\"851\" height=\"548\" \u003e\u003c/div\u003e\u003cspan class=\"image-introduction-wrap\"\u003e\u003cspan class=\"photo-by\"\u003ePhoto by\u003c/span\u003e\u003cspan class=\"credit-text\"\u003e\u003ca href=\"https://www.facebook.com/photo.php?fbid=1395397302627050\u0026amp;set=pb.100064703799229.-2207520000\u0026amp;type=3\" target=\"_blank\"\u003eGrandma's Marathon - Duluth, Inc. | Facebook\u003c/a\u003e\u003c/span\u003e\u003c/span\u003e\u003c/div\u003e\u003c/div\u003e\u003c/figure\u003e\u003ch2 class=\"NBAIEditor_Theme__h2\" dir=\"ltr\"\u003e\u003cspan\u003eFrom Small Start to Major Event\u003c/span\u003e\u003c/h2\u003e\u003cp class=\"NBAIEditor_Theme__paragraph\" dir=\"ltr\"\u003e\u003cspan\u003eWhen Grandma's Marathon began in 1977, the newly opened Grandma's Restaurant was the only local business willing to sponsor the race, contributing $600 toward a total budget of just $600 to $1,200. Organizers expected maybe 160 runners. They got exactly that—and 10 of them were women, a significant number for the era.\u003c/span\u003e\u003c/p\u003e\u003cp class=\"NBAIEditor_Theme__paragraph\" dir=\"ltr\"\u003e\u003cspan\u003eNearly 50 years later, more than 235,000 runners have finished Grandma's Marathon. The race has become so popular that organizers are on track to reach the quarter-million mark during this 50th anniversary year.\u003c/span\u003e\u003c/p\u003e\u003ch2 class=\"NBAIEditor_Theme__h2\" dir=\"ltr\"\u003e\u003cspan\u003eWhat's Happening This Weekend\u003c/span\u003e\u003c/h2\u003e\u003cp class=\"NBAIEditor_Theme__paragraph\" dir=\"ltr\"\u003e\u003cspan\u003eRace day is Saturday, June 20. If you're not running, there's still plenty to do. The Race Weekend festivities include the Garry Bjorklund Half Marathon on Friday evening, live music at Rock the Bayfront (a free concert series), and countless celebrations throughout Duluth's waterfront.\u003c/span\u003e\u003c/p\u003e\u003ch2 class=\"NBAIEditor_Theme__h2\" dir=\"ltr\"\u003e\u003cspan\u003ePlan Your Visit\u003c/span\u003e\u003c/h2\u003e\u003cp class=\"NBAIEditor_Theme__paragraph\" dir=\"ltr\"\u003e\u003cspan\u003eIf you're heading to Duluth to watch the race or celebrate the weekend, note that Highway 61 and I-35 will have road closures from 4 a.m. to 3 p.m. on Saturday as the race course uses these roads. Plan accordingly if you're traveling in the area.\u003c/span\u003e\u003c/p\u003e\u003cp class=\"NBAIEditor_Theme__paragraph\" dir=\"ltr\"\u003e\u003cspan\u003eFor spectators, the best viewing spots are along the final miles in Duluth—the last two miles offer the most exciting finish-line energy. Bring water, snacks, and signs to cheer on these determined athletes.\u003c/span\u003e\u003c/p\u003e\u003cp class=\"NBAIEditor_Theme__paragraph\" dir=\"ltr\"\u003e\u003cspan\u003eTo learn more about the race, visit \u003c/span\u003e\u003ca href=\"https://grandmasmarathon.com/the-marathon/grandmas-marathon/\" rel=\"noopener\" class=\"NBAIEditor_Theme__link\"\u003e\u003cspan\u003eGrandma's Marathon official site\u003c/span\u003e\u003c/a\u003e\u003cspan\u003e for race details, spectator information, and the full weekend schedule.\u003c/span\u003e\u003c/p\u003e\u003cp class=\"NBAIEditor_Theme__paragraph\" dir=\"ltr\"\u003e\u003cspan\u003eWhether you're running, watching, or just enjoying Duluth's incredible June weather and festival atmosphere, Grandma's Marathon weekend is Minnesota at its finest.\u003c/span\u003e\u003c/p\u003e\u003cp class=\"NBAIEditor_Theme__paragraph\"\u003e\u003cbr\u003e\u003c/p\u003e\u003cstyle style=\"display: none\"\u003e.NBAIEditor_Theme__ol1 {padding: 0 0 0 20px !important;margin: 0 0 24px 0 !important;list-style-position: outside !important;}.NBAIEditor_Theme__ol2 {padding: 0 !important;margin: 0 !important;list-style-type: lower-alpha !important;list-style-position: outside !important;}html body.post #content-div .content ol li ol {margin: 0 !important;}.NBAIEditor_Theme__ol3 {padding: 0 !important;margin: 0 !important;list-style-type: lower-roman !important;list-style-position: outside !important;}.NBAIEditor_Theme__ol4 {padding: 0;margin: 0;list-style-type: upper-roman !important;list-style-position: outside !important;}.NBAIEditor_Theme__ol5 {padding: 0;margin: 0;list-style-type: lower-roman !important;list-style-position: outside !important;}.NBAIEditor_The