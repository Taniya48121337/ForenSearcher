<script>
document.addEventListener("DOMContentLoaded", function() {
    var currentPath = window.location.pathname.replace(/\/$/, "");
    if (currentPath === "") currentPath = "/"; 

    var navSelectors = 'nav a, .hs-menu-wrapper a, .support_sidebar a, .sidebar a, .left-nav a';
    var links = document.querySelectorAll(navSelectors);

    links.forEach(function(link) {
        var href = link.getAttribute('href');

        if (href && href !== "javascript:;" && !href.startsWith("#")) {
            try {
                var linkUrl = new URL(href, window.location.origin);
                var linkPath = linkUrl.pathname.replace(/\/$/, "");
                if (linkPath === "") linkPath = "/";

                if (linkPath === currentPath) {
                    link.setAttribute('aria-current', 'page');
                }
            } catch (e) {
               
            }
        }
    });
});
</script>

<script>
document.addEventListener("DOMContentLoaded", function() {

    if (document.querySelector('main, [role="main"]')) return;

    function findValidElement(selector) {
        var elements = document.querySelectorAll(selector);
        for (var i = 0; i < elements.length; i++) {

            if (!elements[i].closest('header, [role="banner"], .header-container, .site-header')) {
                return elements[i];
            }
        }
        return null;
    }

    var potentialColumn = findValidElement('.span10, .span9, .main-content-wrapper');

    if (potentialColumn) {

        var mainTitle = document.querySelector('h1');
        var rightColumn = null;

        if (mainTitle) {

            var closestCol = mainTitle.closest('.span10, .span9, .main-content-wrapper');

            if (closestCol && !closestCol.closest('header, [role="banner"]')) {
                rightColumn = closestCol;
            }
        }

        if (!rightColumn) {
            rightColumn = potentialColumn;
        }

        if (rightColumn) {
            rightColumn.setAttribute('role', 'main');
        }
        
    } else {

        var fullWidthContainer = findValidElement('.body-container--home, .body-container, .content-wrapper');
        
        if (fullWidthContainer) {
            fullWidthContainer.setAttribute('role', 'main');
        }
    }
});
</script>

