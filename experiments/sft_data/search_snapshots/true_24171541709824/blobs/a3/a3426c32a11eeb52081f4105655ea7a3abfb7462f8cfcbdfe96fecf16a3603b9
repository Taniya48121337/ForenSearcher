                                            <a href="#blogRelatedImgPopUp" data-slickindex="1" data-multimedia="battle-flag-of-the-twenty-eighth-virginia-volunteer-infantry-regiment" class="btn blogRelatedImgPopUp noAnchorIDScroll"></a>
                                             
                                            
                                            
                                            

                                            
                                            
                                            <img src="https://www.mnhs.org/hs-fs/hubfs/Mnopedia%20Blogs/10242225.640x640.jpg?width=500&amp;height=400&amp;name=10242225.640x640.jpg" alt="Battle flag of the Twenty-eighth Virginia Volunteer Infantry Regiment" loading="lazy" width="500" height="400" srcset="https://www.mnhs.org/hs-fs/hubfs/Mnopedia%20Blogs/10242225.640x640.jpg?width=250&amp;height=200&amp;name=10242225.640x640.jpg 250w, https://www.mnhs.org/hs-fs/hubfs/Mnopedia%20Blogs/10242225.640x640.jpg?width=500&amp;height=400&amp;name=10242225.640x640.jpg 500w, https://www.mnhs.org/hs-fs/hubfs/Mnopedia%20Blogs/10242225.640x640.jpg?width=750&amp;height=600&amp;name=10242225.640x640.jpg 750w, https://www.mnhs.org/hs-fs/hubfs/Mnopedia%20Blogs/10242225.640x640.jpg?width=1000&amp;height=800&amp;name=10242225.640x640.jpg 1000w, https://www.mnhs.org/hs-fs/hubfs/Mnopedia%20Blogs/10242225.640x640.jpg?width=1250&amp;height=1000&amp;name=10242225.640x640.jpg 1250w, https://www.mnhs.org/hs-fs/hubfs/Mnopedia%20Blogs/10242225.640x640.jpg?width=1500&amp;height=1200&amp;name=10242225.640x640.jpg 1500w" sizes="(max-width: 500px) 100vw, 500px">
                                            
