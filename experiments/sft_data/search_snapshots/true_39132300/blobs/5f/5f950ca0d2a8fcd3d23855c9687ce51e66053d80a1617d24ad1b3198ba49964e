dac" class="W4V2qg comp-kydjadac wixui-image"><div data-testid="linkElement" class="apPOZK"><img loading="lazy" sizes="443px" srcSet="https://static.wixstatic.com/media/c5c9bd_7b49d4d7b95b49a7b765ef85a80f1a17~mv2.png/v1/fill/w_443,h_285,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/Screen%20Shot%202022-01-13%20at%202_57_49%20PM.png 1x, https://static.wixstatic.com/media/c5c9bd_7b49d4d7b95b49a7b765ef85a80f1a17~mv2.png/v1/fill/w_886,h_570,al_c,q_90,usm_0.66_1.00_0.01,enc_avif,quality_auto/Screen%20Shot%202022-01-13%20at%202_57_49%20PM.png 2x" id="img_comp-kydjadac" src="https://static.wixstatic.com/media/c5c9bd_7b49d4d7b95b49a7b765ef85a80f1a17~mv2.png/v1/fill/w_443,h_285,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/Screen%20Shot%202022-01-13%20at%202_57_49%20PM.png" alt="Screen Shot 2022-01-13 at 2.57.49 PM.png" style="object-fit:cover" class="gRkIq0 sFiSiq" width="443" height="285"/></div></div><!--/$--><!--$--><div id="comp-kydjc2w3" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-kydjc2w3 wixui-rich-text" data-testid="richTextElement"><p class="font_7 wixui-rich-text__text" style="font-size:12px;"><span class="color_38 wixui-rich-text__text"><span style="font-family:futura-lt-w01-light,futura-lt-w05-light,sans-serif;" class="wixui-rich-text__text"><span style="font-size:12px;" class="wixui-rich-text__text">Example of exposed perimeter lines on &quot;Scream 2 style&quot; masks. The perimeter line is present on all mask types but are usually covered by the shroud. We believe this line was used as a guide to cut out a raw casting.</span></span></span></p></div><!--/$--><!--$--><div id="comp-kydjadar" class="W4V2qg comp-kydjadar wixui-image"><div data-testid="linkElement" class="apPOZK"><img loading="lazy" sizes="443px" srcSet="https://static.wixstatic.com/media/c5c9bd_4eb734521a1746ccb7aab78febacfd0b~mv2.jpg/v1/fill/w_443,h_285,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/271196538_1647480365587114_5096024724885520322_n.jpg 1x, https://static.wixstatic.com/media/c5c9bd_4eb734521a1746ccb7aab78febacfd0b~mv2.jpg/v1/fill/w_886,h_570,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/271196538_1647480365587114_5096024724885520322_n.jpg 2x" id="img_comp-kydjadar" src="https://static.wixstatic.com/media/c5c9bd_4eb734521a1746ccb7aab78febacfd0b~mv2.jpg/v1/fill/w_443,h_285,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/271196538_1647480365587114_5096024724885520322_n.jpg" alt="271196538_1647480365587114_5096024724885520322_n.jpg" style="object-fit:cover" class="gRkIq0 sFiSiq" width="443" height="285"/></div></div><!--/$--><!--$--><div id="comp-kydjci9p" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-kydjci9p wixui-rich-text" data-testid="richTextElement"><p class="font_7 wixui-rich-text__text" style="font-size:12px;"><span class="color_38 wixui-rich-text__text"><span style="font-family:futura-lt-w01-light,futura-lt-w05-light,sans-serif;" class="wixui-rich-text__text"><span style="font-size:12px;" class="wixui-rich-text__text">On Gen 2s, visible remnants of the previous perimeter line are covered and moved about a half inch.</span></span></span></p></div><!--/$--><!--$--><div id="comp-lpnat9en" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-lpnat9en wixui-rich-text" data-testid="richTextElement"><p class="font_7 wixui-rich-text__text" style="font-size:17px;"><span style="color:#FFFFFF;" class="wixui-rich-text__text"><span style="font-family:futura-lt-w01-light,futura-lt-w05-light,sans-serif;" class="wixui-rich-text__text">Gen 2 molds were made to increase production of all Fun World&#39;s ghost characters in the #9206 assortment. They also exhibit a similar long face and stuffed look with deeper jawlines.</span></span></p></div><!--/$--><!--$--><div id="comp-li4q9s9b" class="gpDCD5 comp-li4q9s9b"><div class="jv9xi4 wixui-box" data-testid="container-bg"></div><div data-mesh-id="comp-li4q9s9binlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-li4q9s9binlineContent-gridContainer" data-testid="mesh-container-content"><!--$--><div id="comp-li4qa5yx" class="W4V2qg comp-li4qa5yx wixui-image"><div data-testid="linkElement" class="apPOZK"><img loading="lazy" sizes="359px" srcSet="https://static.wixstatic.com/media/c5c9bd_3c0484875a694977b80a0e36f3e03117~mv2.png/v1/fill/w_359,h_507,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/Gen%202%20Happy.png 1x, https://static.wixstatic.com/media/c5c9bd_3c0484875a694977b80a0e36f3e03117~mv2.png/v1/fill/w_718,h_1014,al_c,q_90,usm_0.66_1.00_0.01,enc_avif,quality_auto/Gen%202%20Happy.png 2x" id="img_comp-li4qa5yx" src="https://static.wixstatic.com/media/c5c9bd_3c0484875a694977b80a0e36f3e03117~mv2.png/v1/fill/w_359,h_507,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/Gen%202%20Happy.png" alt="Gen 2 Happy.png" style="object-fit:cover" class="gRkIq0 sFiSiq" width="359" height="507"/></div></div><!--/$--></div></div></div><!--/$--><!--$--><div id="comp-kykhj4u0" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-kykhj4u0 wixui-rich-text" data-testid="richTextElement"><p class="font_7 wixui-rich-text__text" style="font-size:12px; text-align:center;"><span class="color_38 wixui-rich-text__text"><span style="font-family:futura-lt-w01-light,futura-lt-w05-light,sans-serif;" class="wixui-rich-text__text"><span style="font-size:12px;" class="wixui-rich-text__text">Wide jaw on a Gen 2 &#39;Happy&#39; ghost with exposed perimeter lines.</span></span></span></p></div><!--/$--><!--$--><div id="comp-kydjk5om" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-kydjk5om wixui-rich-text" data-testid="richTextElement"><p class="font_7 wixui-rich-text__text" style="font-size:17px;"><span style="color:#000000;" class="wixui-rich-text__text"><span style="font-family:futura-lt-w01-book,futura-lt-w05-book,sans-serif;" class="wixui-rich-text__text"><span style="text-shadow:#ffffff -1px -1px 0px, #ffffff -1px 1px 0px, #ffffff 1px 1px 0px, #ffffff 1px -1px 0px;" class="wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text">*Gen 2 masks have been found as #9206 Glow-in-Dark Ghost Mask with Shroud (cotton, poly), #9207 Fluorescent Ghost Mask with Shroud (cotton, poly), #9223 All-in-One Ghost Mask &amp; Gown, #9219 Instant Disguise, #8919 Droop Collar Mask, and #9974 Scream Stalker costume masks with bib.</span></span></span></span></p></div><!--/$--><!--$--><div id="comp-mmxr47s0" class="comp-mmxr47s0 nJiBti wixui-horizontal-line"></div><!--/$--><!--$--><div id="comp-mmxr40d9" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mmxr40d9 wixui-rich-text" data-testid="richTextElement"><h1 class="font_0 wixui-rich-text__text" style="font-size:37px; text-align:center;"><span style="font-weight:normal;" class="wixui-rich-text__text"><span style="font-family:caudex,serif;" class="wixui-rich-text__text"><span style="color:#FFFFFF;" class="wixui-rich-text__text"><span style="font-size:37px;" class="wixui-rich-text__text">NU-GEN</span></span></span></span></h1></div><!--/$--><!--$--><div id="comp-mmxr40dh" class="gpDCD5 comp-mmxr40dh"><div class="jv9xi4 wixui-box" data-testid="container-bg"></div><div data-mesh-id="comp-mmxr40dhinlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-mmxr40dhinlineContent-gridContainer" data-testid="mesh-container-content"><!--$--><div id="comp-mmxr40eo1" class="W4V2qg comp-mmxr40eo1 wixui-image"><div data-testid="linkElement" class="apPOZK"><img loading="lazy" sizes="389px" srcSet="https://static.wixstatic.com/media/c5c9bd_d6cef1f71b234ea9b79f2ffc46a77837~mv2.png/v1/fill/w_389,h_514,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/NuGen.png 1x, https://static.wixstatic.com/media/c5c9bd_d6cef1f71b234ea9b79f2ffc46a77837~mv2.png/v1/fill/w_778,h_1028,al_c,q_90,usm_0.66_1.00_0.01,enc_avif,quality_auto/NuGen.png 2x" id="img_comp-mmxr40eo1" src="https://static.wixstatic.com/media/c5c9bd_d6cef1f71b234ea9b79f2ffc46a77837~mv2.png/v1/fill/w_389,h_514,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/NuGen.png" alt="NuGen.png" style="object-fit:cover" class="gRkIq0 sFiSiq" width="389" height="514"/></div></div><!--/$--></div></div></div><!--/$--><!--$--><div id="comp-mmxr40do" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mmxr40do wixui-rich-text" data-testid="richTextElement"><p class="font_7 wixui-rich-text__text" style="font-size:17px;"><span style="color:#FFFFFF;" class="wixui-rich-text__text"><span style="font-family:futura-lt-w01-light,futura-lt-w05-light,sans-serif;" class="wixui-rich-text__text">Fun World is resurrecting the original &#39;Weeping&#39; ghost in 2026. It will be featured this year on select&nbsp;<span style="font-style:italic;" class="wixui-rich-text__text">30th Anniversary Ghost Face&nbsp;</span>products celebrating Scream (1996). This new mask was created using an original Gen 1&mdash; though by what process we do not yet know. The initial launch of the&nbsp;<span style="font-style:italic;" class="wixui-rich-text__text">Nu-Gen</span>&nbsp;molds will have a short tasselless shroud and detachable sparkle hood for the <span style="font-style:italic;" class="wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text">#93828 - Ghost Face 30th Anniversary Mask</span>&nbsp;</span>product; and various&nbsp;<span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-style:italic;" class="wixui-rich-text__text">30th Anniversary Ghost Face&nbsp;</span>costumes</span> with a movie-style sparkle fabric robe. Though it&#39;s future is uncertain, Fun World&#39;s RJ Torbert has said they hope to use the new mask type on new non-anniversary products at a later time.</span></span></p></div><!--/$--><!--$--><div id="comp-mmxrj0nu" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mmxrj0nu wixui-rich-text" data-testid="richTextElement"><p class="font_7 wixui-rich-text__text" style="font-size:17px;"><span style="color:#000000;" class="wixui-rich-text__text"><span style="font-family:futura-lt-w01-book,futura-lt-w05-book,sans-serif;" class="wixui-rich-text__text"><span style="text-shadow:#ffffff -1px -1px 0px, #ffffff -1px 1px 0px,