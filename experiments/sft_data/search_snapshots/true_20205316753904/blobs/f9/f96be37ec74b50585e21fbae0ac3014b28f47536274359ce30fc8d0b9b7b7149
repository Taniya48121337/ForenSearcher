        onConsentReady: function (message_type, uuid, string, info) {
          console.log(message_type, uuid, string, info);
          console.log("[event] onConsentReady", arguments);

          // Configure privacy anchor for applicable regions
          configurePrivacyAnchor(message_type, info);

          // Track which consent frameworks apply and have been processed
          if (message_type == "usnat") {
            window._usnatApplies = info.applies;
            window._consentUSNATProcessed = true;
          }
          if (message_type == "gdpr") {
            window._gdprApplies = info.applies;
            window._consentGDPRProcessed = true;
          }

          // SCENARIO 1: US NAT (US states) - Opt-out model
          // Check actual consent via getUserConsents callback
          if (message_type == "usnat" && info.applies) {
            window._sp_.usnat.getUserConsents(function (consents) {
              // Check if user consented (didn't opt out)
              const hasConsent =
                consents.categories &&
                consents.categories.length > 0 &&
                consents.categories[0].consented === true;

              if (hasConsent) {
                console.log("[US NAT] User has not opted out, loading scripts");
                loadAnalyticsScripts();
                fireGTMConsentEvent(message_type);
              } else {
                console.log("[US NAT] User opted out, scripts blocked");
              }
            });
          }

          // SCENARIO 2: GDPR (UK/EU) - Opt-in model
          // Load scripts ONLY if user explicitly consented
          if (message_type == "gdpr" && info.applies) {
            if (info.consentedToAll === true) {
              console.log("[GDPR] User consented, loading scripts");
              loadAnalyticsScripts();
              fireGTMConsentEvent(message_type);
            } else {
              console.log("[GDPR] User did not consent, scripts blocked");
            }
          }

          // SCENARIO 3: Other countries - No CMP requirement
          // Use timeout to wait for final determination after both frameworks are processed
          if (window._consentUSNATProcessed && window._consentGDPRProcessed) {
            if (!window._noCMPCheckScheduled) {
              window._noCMPCheckScheduled = true;
              console.log("[Debug] Scheduling No CMP check in 2 seconds...");

              setTimeout(function () {
                console.log(
                  "[Debug] Final status - USNAT applies:",
                  window._usnatApplies,
                  "GDPR applies:",
                  window._gdprApplies
                );

                // If neither framework applies after waiting, load scripts
                if (!window._usnatApplies && !window._gdprApplies) {
                  console.log(
                    "[No CMP Required] Loading scripts for non-regulated region"
                  );
                  loadAnalyticsScripts();
                  fireGTMConsentEvent("none");
                }
              }, 2000);
            }
          }
        },
        onPrivacyManagerAction: function (message_type, pmData) {
          console.log("[event] onPrivacyManagerAction", arguments);

          // Handle consent changes through Privacy Manager
          if (message_type === "usnat" && pmData) {
            // Check consent status after PM action
            window._sp_.usnat.getUserConsents(function (consents) {
              const hasConsent =
                consents.categories &&
                consents.categories.length > 0 &&
                consents.categories[0].consented === true;

              if (pmData.action === "REJECT_ALL" || !hasConsent) {
                console.log(
                  "[US NAT] User opted out via Privacy Manager, reloading page"
                );
                window.location.reload();
              } else if (pmData.action === "ACCEPT_ALL" || hasConsent) {
                console.log("[US NAT] User consented via Privacy Manager");
                loadAnalyticsScripts();
                fireGTMConsentEvent();
              }
            });
          }

          if (message_type === "gdpr" && pmData) {
            if (pmData.action === "ACCEPT_ALL") {
              console.log("[GDPR] User accepted via Privacy Manager");
              loadAnalyticsScripts();
              fireGTMConsentEvent();
            } else if (pmData.action === "REJECT_ALL") {
              console.log(
                "[GDPR] User rejected via Privacy Manager, reloading page"
              );
              window.location.reload();
            }
          }
        },
        onPMCancel: function () {
          console.log("[event] onPMCancel", arguments);
        },
      },
    },
  };

  // Configure privacy anchor based on consent type
  // Track if privacy anchor has been configured to avoid duplicates
  function configurePrivacyAnchor(message_type, info) {
    console.log("configurePrivacyAnchor", message_type, info);

    // Skip if doesn't apply
    if (!info.applies) {
      console.log("Skipping privacy anchor - framework doesn't apply");
      return;
    }

    // Skip if already configured
    if (window._privacyAnchorConfigured) {
      console.log("Privacy anchor already configured");
      return;
    }

    REBELMOUSE_STDLIB.createElementChangeListener(
      'a[aria-label="privacy-settings"]',
      function (privacyAnchor) {
        if (message_type == "usnat" && info.applies) {
          console.log(
            "usnat---> configurePrivacyAnchor",
            privacyAnchor,
            message_type
          );
          privacyAnchor.style.visibility = "visible";
          privacyAnchor.innerHTML =
            "Do Not Sell or Share My Personal Information";
          privacyAnchor.href =
            "javascript:window._sp_.usnat.loadPrivacyManagerModal(1389210);";
          window._privacyAnchorConfigured = true;
        }

        if (message_type == "gdpr" && info.applies) {
          console.log(
            "gdpr---> configurePrivacyAnchor",
            privacyAnchor,
            message_type
          );
          privacyAnchor.style.visibility = "visible";
          privacyAnchor.innerHTML = "Manage consent";
          privacyAnchor.href =
            "javascript:window._sp_.gdpr.loadPrivacyManagerModal(559404);";
          window._privacyAnchorConfigured = true;
        }
      },
      true // Changed back to true - trigger on existing elements
    );
  }

